<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Başlık Bölümü -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Username"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ 2/2"
                android:textSize="14sp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- İkon Bilgileri -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvM3uStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M3U: ✅"
                android:textSize="12sp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvApiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API: ✅"
                android:textSize="12sp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvChannels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 1200"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Detay Bilgiler (Başlangıçta Gizli) -->
        <LinearLayout
            android:id="@+id/layoutDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:background="#F5F5F5"
            android:padding="12dp">

            <!-- Panel URL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Panel URL:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvPanelUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="example.com:8080"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"
                android:textIsSelectable="true" />

            <!-- Username -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kullanıcı Adı:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvUsernameDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="testuser123"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"
                android:textIsSelectable="true" />

            <!-- Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Şifre:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="testpass456"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"
                android:textIsSelectable="true" />

            <!-- Tam Link -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tam Link:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvFullLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="http://example.com:8080/..."
                android:textSize="11sp"
                android:layout_marginBottom="8dp"
                android:textIsSelectable="true"
                android:autoLink="web" />

            <!-- Kullanıcı Bilgileri -->
            <TextView
                android:id="@+id/tvUserInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 3/5 | 📅 31.12.2025"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <!-- Kopyalama Butonu -->
            <Button
                android:id="@+id/btnCopyLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Linki Kopyala"
                android:textSize="12sp"
                android:backgroundTint="#4CAF50" />

        </LinearLayout>

        <!-- Genişlet/Daralt Butonu -->
        <Button
            android:id="@+id/btnToggleDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▼ Detayları Göster"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2196F3" />

    </LinearLayout>

</androidx.cardview.widget.CardView>