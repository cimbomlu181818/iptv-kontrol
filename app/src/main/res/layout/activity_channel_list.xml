<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Başlık -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📺 Kanal Listesi"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        android:background="#2196F3"
        android:textColor="#FFFFFF" />

    <!-- İstatistik -->
    <TextView
        android:id="@+id/tvChannelStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Yükleniyor..."
        android:textSize="14sp"
        android:gravity="center"
        android:padding="12dp"
        android:background="#E3F2FD" />

    <!-- Arama Çubuğu -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:queryHint="Kategori veya kanal ara..."
        android:iconifiedByDefault="false" />

    <!-- Kanal Listesi -->
    <ExpandableListView
        android:id="@+id/expandableChannelList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <!-- Alt Buton -->
    <Button
        android:id="@+id/btnBackFromChannels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔙 GERİ DÖN"
        android:textSize="16sp"
        android:backgroundTint="#607D8B"
        android:textColor="#FFFFFF"
        android:layout_margin="16dp" />

</LinearLayout>